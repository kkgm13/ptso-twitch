{
  "name": "ptso-twitch",
  "version": "3.0",
  "description": "Personal Textual Shoutout Overlay System with Twitch",
  "type": "module",
  "scripts": {
    "start": "node app.js",
    "twitch-setup": "node scripts/setup-script.js",
    "db": "node scripts/db-check.js",
    "test": "node --test",
    "css-build": "npx tailwindcss -i ./public/admin/assets/css/input.css -o ./public/admin/assets/css/stylesheet.css",
    "css-dev": "npx tailwindcss -i ./public/admin/assets/css/input.css -o ./public/admin/assets/css/stylesheet.css --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkgm13/ptso-twitch.git"
  },
  "author": "KKGM13",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/kkgm13/ptso-twitch/issues"
  },
  "homepage": "https://github.com/kkgm13/ptso-twitch#readme",
  "dependencies": {
    "@tailwindcss/cli": "^4.*",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "better-sqlite3@13.0.3": true
  }
}
